# ==================== SERVER ====================
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=indivo
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10

# ==================== JWT ====================
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ==================== BCRYPT ====================
BCRYPT_ROUNDS=12

# ==================== ENCRYPTION ====================
# 32-byte hex key for AES-256-GCM (e.g. `openssl rand -hex 32`). Used for seller bank account numbers.
ENCRYPTION_KEY=

# ==================== FILE UPLOADS ====================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHECKOUT_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_MAX=60

# ==================== ORDER / STOCK ====================
UNPAID_ORDER_EXPIRY_MINUTES=30

# ==================== SUPER ADMIN (first-run seed) ====================
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_PASSWORD=change_this_password
SUPER_ADMIN_NAME=INDIVO Super Admin
SUPER_ADMIN_EMAIL=admin@indivo.iharogroups.com
